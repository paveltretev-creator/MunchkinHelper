2026-10-29 19:47:52.696 MSK [28456] ERROR:  relation "users" already exists
2026-10-29 19:47:52.696 MSK [28456] STATEMENT:  CREATE TABLE Users (
	    id_user SERIAL PRIMARY KEY,
	    login VARCHAR(255) NOT NULL UNIQUE,
	    password_hash VARCHAR(255) NOT NULL
	);
	
	CREATE TABLE Races (
	    id_race SERIAL PRIMARY KEY,
	    name VARCHAR(255) NOT NULL,
	    ability_1 TEXT,
	    ability_2 TEXT,
	    epic_ability_1 TEXT,
	    epic_ability_2 TEXT
	);
	
	CREATE TABLE Classes (
	    id_class SERIAL PRIMARY KEY,
	    name VARCHAR(255) NOT NULL,
	    ability_1 TEXT,
	    ability_2 TEXT,
	    epic_ability_1 TEXT,
	    epic_ability_2 TEXT
	);
	
	CREATE TABLE Dungeons (
	    id_dungeon SERIAL PRIMARY KEY,
	    name VARCHAR(255) NOT NULL,
	    description TEXT
	);
	
	CREATE TABLE Bestiary (
	    id_bestiary SERIAL PRIMARY KEY,
	    name VARCHAR(255) NOT NULL,
	    level INTEGER NOT NULL,
	    description TEXT,
	    quirk TEXT,
	    xp_reward INTEGER NOT NULL,
	    treasure_reward INTEGER NOT NULL,
	    monster_type VARCHAR(50) NOT NULL CHECK (monster_type IN ('normal', 'undead', 'dragon'))
	);
	
	CREATE TABLE User_Additions (
	    id_addition SERIAL PRIMARY KEY,
	    id_user INTEGER NOT NULL,
	    target_entity_id INTEGER NOT NULL,
	    target_entity_type VARCHAR(50) NOT NULL CHECK (target_entity_type IN ('race', 'class', 'monster', 'dungeon')),
	    FOREIGN KEY (id_user) REFERENCES Users(id_user) ON DELETE CASCADE
	);
